{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/run-tests.sh",
            "timeout": 120,
            "statusMessage": "Running tests after edit"
          }
        ]
      }
    ]
  }
}
